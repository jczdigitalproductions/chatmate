META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
FETCH_AGENT_SEED=
# Comma-separated agent addresses permitted to request paid reviews.
FETCH_ALLOWED_SENDERS=
FETCH_PORT=8001
FETCH_ENDPOINT=http://127.0.0.1:8001/submit
# Separate credentials: operator freezes tests; submitters can only verify.
CHATMATE_OPERATOR_TOKEN=
CHATMATE_SUBMIT_TOKEN=
# Optional absolute path to verifier-owned storage, outside candidate worktrees.
CHATMATE_STATE_DIR=
# Agentverse gateway mode (not needed for direct/local verification).
AGENTVERSE_API_KEY=
META_MODEL_API_KEY=
ASI_ONE_API_KEY=
CHATMATE_AGENT_ADDRESS=
# Shared by the trusted gateway and remote verifier agent; distinct from API keys.
CHATMATE_AGENT_QUERY_TOKEN=
# ASI_ONE_API_KEY is entered in VS Code SecretStorage, not this file.
